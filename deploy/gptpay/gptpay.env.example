# New source: each visitor supplies optional SOCKS5; empty means direct.
# Keep false until this new version has been tested and deployed.
GPTPAY_ENABLED=false
GPTPAY_ORIGIN=https://gptpay.novadiffusion.com
GPTPAY_STATE_DIR=/var/lib/gptpay/payments
# Configure only on the server in a root-owned 0600 EnvironmentFile.
# GPTPAY_SOCKS5 is no longer used; do not store visitors' proxy credentials here.
